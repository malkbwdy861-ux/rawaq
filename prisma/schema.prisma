  serviceVersionId String
  projectId        String
  serviceVersion   ServiceVersion @relation(fields: [serviceVersionId], references: [id], onDelete: Cascade)
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@id([serviceVersionId, projectId])
  @@index([projectId])
}

model ServiceVersionArticle {
  serviceVersionId String
  articleId        String
  serviceVersion   ServiceVersion @relation(fields: [serviceVersionId], references: [id], onDelete: Cascade)
  article          Article        @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@id([serviceVersionId, articleId])
  @@index([articleId])
}

model ServiceVersionFAQ {
  serviceVersionId String
  faqId            String
  serviceVersion   ServiceVersion @relation(fields: [serviceVersionId], references: [id], onDelete: Cascade)
  faq              FAQ            @relation(fields: [faqId], references: [id], onDelete: Restrict)

  @@id([serviceVersionId, faqId])
